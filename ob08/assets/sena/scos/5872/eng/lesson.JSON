 "objective"}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " What's work like in the 21st century?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: \n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence. </span><span class=\"bullet\">Use capital letters where needed.\n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn6le13ob08re2aud01", "coverimg": "engenn6le13ob08re2img01.jpg", "images": [{"image": "engenn6le13ob08re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn6le13ob08re2img01.jpg", "text": "Women's Professional Soccer - A Level Playing Field?", "id": 1, "time": "100"}, {"image": "engenn6le13ob08re2img01.jpg", "text": "The FIFA Women's World Cup was held here recently, with record-breaking attendance. Tickets for the final game sold out months ago. This is a pattern we've seen since the London Olympics, where another record-setting number of people attended the women's soccer matches. Clearly, more people have become interested in women's soccer and will pay to see the games.", "id": 2, "time": "3700"}, {"image": "engenn6le13ob08re2img02.jpg", "text": "Women's soccer has been described as the fastest-growing sport on the planet. The number of teams competing in the tournaments has increased two-fold. FIFA's broadcasting department has promised the largest coverage online and on TV ever. Even the gaming industry has exploded with new women's soccer video games and products.", "id": 3, "time": "24000"}, {"image": "engenn6le13ob08re2img03.jpg", "text": "Even though all of this progress is being made, inequality and sexism still exist when it comes to salary and sponsorships. Female professional soccer players still earn significantly less than their male counterparts. Sexist ideas such as making the uniforms tighter to attract more audiences still permeate the upper management.", "id": 4, "time": "43300"}, {"image": "engenn6le13ob08re2img03.jpg", "text": "In short, women's professional soccer remains in a precarious position. Until we see a change in attitude both at a management and spectator level, there is still a long way to go to achieve a level playing field.", "id": 5, "time": "62000"}]}}], "id": 1}, {"template_override": 1, "_data": [], "type": "video", "title": "", "contents": [{"type": "video", "value": {"video_src": "engenn6le13ob08re3vid01", "images": [{"image": "", "text": "Writing a Short News Article <br><br>\n1. Write a headline (a short summary) <br>\n2. Use words that are more complicated than words used in conversation.<br>\n3. Use the Present Perfect tense. <br>\n4. Summarize the point in the final paragraph.", "id": 0, "time": "0"}]}}], "id": 2}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Gender Issues", "type": "lesson_name"}, {"content": "The News Article", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe routines and regular activities in a wider range of social and work contexts.", "type": "primary"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_5"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_6"}, {"content": "Writes short texts using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"content": "engenn6le13ob08re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Writing A Short News Article", "type": "heading"}, {"content": "  When writing a short news article, there are a few rules you need to follow.", "type": "describer"}, {"content": "Write a <span class=\"strong\">headline</span> for the article that is a short summary of what the article is about. That way, your readers can predict what they are going to read. Keep the headline short and interesting. ", "type": "text"}, {"content": "You use words that are at a slightly higher level than you would in conversation. Try to use adjectives and adverbs to make your article interesting to read.", "type": "text"}, {"content": " You use the <span class=\"strong\">Present Perfect tense</span> often to show how past events are connected to the article (written in the present).", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "record-breaking", "type": "name"}, {"content": "going past a record or best ever achievement", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The FIFA Women's World Cup was held here recently, with record-breaking attendance.", "type": "example"}, {"content": "engenn6le13ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to write a news article.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to sell out ", "type": "name"}, {"content": "to sell all of something so that there is none left to buy", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Tickets for the final game sold out months ago.", "type": "example"}, {"content": "engenn6le13ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "broadcasting", "type": "name"}, {"content": "transmit information on the radio or TV", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: FIFA's broadcasting department has promised the biggest amount of coverage on TV ever.", "type": "example"}, {"content": "engenn6le13ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sexism", "type": "name"}, {"content": "discrimination against women on the basis of sex", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Even though all of this progress is being made, inequality and sexism still exist. ", "type": "example"}, {"content": "engenn6le13ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "upper management", "type": "name"}, {"content": "the high-level management of a company or organization", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Sexist ideas still exist in the upper management.", "type": "example"}, {"content": "engenn6le13ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "significantly", "type": "name"}, {"content": "in a great or important way", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example:  Female professional soccer players still earn significantly less than their male counterparts.", "type": "example"}, {"content": "engenn6le13ob08aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to permeate", "type": "name"}, {"content": "to be present everywhere", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Sexist ideas still permeate the upper management.", "type": "example"}, {"content": "engenn6le13ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "precarious", "type": "name"}, {"content": "not held in a permanent position; dangerous", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: In short, women's professional soccer remains in a precarious position.", "type": "example"}, {"content": "engenn6le13ob08aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "spectator", "type": "name"}, {"content": "a person who watches a game ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We need to see a change at the spectator level, too.", "type": "example"}, {"content": "engenn6le13ob08aud09", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": "The Present Perfect Tense vs. The Simple Past Tense", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Perfect</span> tense to talk about a finished action or event that is connected to the present in some way.  <br><br>You use the <span class=\"strong\">Simple Past</span> tense to talk about a finished action or event <span class=\"strong\">not</span> necessarily connected to the present.", "type": "describer"}, {"content": "You can use the <span class=\"strong\">Present Perfect </span> tense to talk about experience.", "type": "text"}, {"content": "<span class=\"strong\">Present Perfect</span> expresses an action that began in the past and has recently been finished or continues into the present. There is some connection between what happened in the past and now. ", "type": "text"}, {"content": "<span class=\"strong\">For example:</span> <br> I have learned English = I learned English in the past and now I can speak English. <br>He has bought a painting = He bought the painting in the past and now he has a painting. ", "type": "text"}, {"content": "We use <span class=\"strong\">have/has</span> + <span class=\"strong\">the past participle</span> of the verb in Present Perfect sentences.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past tense form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past participle form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"go\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"went\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"gone\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"see\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"saw\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"seen\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"become\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"became\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"become\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"promise\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"promised\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"promised\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "More people have become interested in women's professional soccer.", "type": "example"}, {"content": "Women's soccer has been described as the fastest-growing sport on the planet.", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "Get a copy of an English newspaper (or print one from the Internet).", "type": "text"}, {"content": "Choose three articles that look interesting.", "type": "text"}, {"content": "In each article, find the headline, adjectives and examples of the Present Perfect tense.", "type": "text"}, {"content": "Read the most interesting one again and look up any words you don't know.", "type": "text"}, {"content": "Share the article with a partner.", "type": "text"}, {"content": "Talk about your opinions about the topic.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I choose and analyze three news articles.", "type": "text"}, {"content": "I read one until I understand it clearly.", "type": "text"}, {"content": "I share my opinion about the article with my partner.", "type": "text"}]}]}